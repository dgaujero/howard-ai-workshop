{
  "name": "howard-ai-workshop",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve howard-ai-workshop",
    "build": "ng build howard-ai-workshop",
    "watch": "ng build howard-ai-workshop --watch --configuration development",
    "test": "ng test howard-ai-workshop",
    "start:complete": "ng serve workshop-complete --port 4201",
    "build:complete": "ng build workshop-complete",
    "test:complete": "ng test workshop-complete",
    "test:copy-bug": "ng test workshop-complete --watch=false --include \"**/stale-copy.demo.ts\""
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
